JWT_SECRET="replace-with-a-long-random-secret"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="your-email@example.com"
EMAIL_PASSWORD="your-gmail-app-password"
